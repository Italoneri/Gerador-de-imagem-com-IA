# ---------------------------------------------------------------------------
# Copie para `.env` na raiz do projeto:  cp .env.example .env
# O `.env` está no .gitignore e é lido SÓ pelo servidor. Nenhuma chave aqui
# chega ao bundle do browser — o front fala apenas com /api/*.
# ---------------------------------------------------------------------------

# Qual provedor de edição de imagem usar: bfl | gemini | nim
IMAGE_PROVIDER=bfl

# --- Black Forest Labs (FLUX.1 Kontext) — padrão -----------------------------
# Chave: https://dashboard.bfl.ai  →  "API Keys". Créditos são pré-pagos.
BFL_API_KEY=
# flux-kontext-pro (padrão) | flux-kontext-max | flux-2-pro | flux-2-flex | flux-2-max
BFL_MODEL=flux-kontext-pro

# --- Google Gemini ("Nano Banana") -------------------------------------------
# Chave: https://aistudio.google.com/apikey  →  "Create API key". Tem free tier.
GEMINI_API_KEY=
# gemini-3.1-flash-image (padrão) | gemini-3-pro-image | gemini-2.5-flash-image
GEMINI_MODEL=gemini-3.1-flash-image

# --- NVIDIA NIM ---------------------------------------------------------------
# Chave: https://build.nvidia.com  →  escolha um modelo  →  "Get API Key".
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=black-forest-labs/flux.1-kontext-dev
NVIDIA_NIM_BASE_URL=https://ai.api.nvidia.com/v1/genai

# --- Servidor -----------------------------------------------------------------
PORT=8787
# Origem liberada no CORS. Em dev o Vite faz proxy, então nem chega a ser usado.
CORS_ORIGIN=http://localhost:5173
# Teto de upload. A BFL aceita até 20 MB / 20 MP; 15 deixa margem para o base64.
MAX_UPLOAD_MB=15
# Tempo total de uma edição, incluindo o polling do provedor.
REQUEST_TIMEOUT_MS=120000
# Requisições de edição por IP a cada 5 minutos.
RATE_LIMIT_MAX=20
